# ── Application ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api
# Name the origins you serve. Production refuses to start with "*", because
# the API sends credentials.
CORS_ORIGINS=*
LOG_LEVEL=debug
# Serves the full API document at /swagger. Defaults off in production —
# set it explicitly to true there only if the docs are meant to be public.
SWAGGER_ENABLED=true
# When both are set, the docs ask for them over HTTP Basic. Leave blank in
# development to browse freely; production refuses to start with the docs
# enabled and no credentials.
SWAGGER_USER=
SWAGGER_PASSWORD=

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user@localhost:5432/deliver_new?schema=public"
DATABASE_POOL_SIZE=10

# ── JWT (generate with: openssl rand -base64 48) ──────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=deliver-api

# Encrypts bank account numbers at rest (openssl rand -base64 48)
ENCRYPTION_KEY=

# ── Secrets in the database (optional) ────────────────────────────────────
# Set this and the credentials in this file can live in the AppSecret table
# instead, managed with `npm run db:secrets`. Leave it blank and everything is
# read from here exactly as before — the store is opt-in, and a value present
# here always wins over a stored one.
#
# This key is never stored in the database itself, and neither is DATABASE_URL:
# they are what reach and decrypt the store. Lose this and the stored values
# cannot be recovered.
#   openssl rand -base64 48
SECRETS_MASTER_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=deliver:

# ── Object storage (MinIO / S3) ───────────────────────────────────────────
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=deliver
STORAGE_SECRET_KEY=deliver-secret
STORAGE_BUCKET=deliver
STORAGE_PUBLIC_BUCKET=deliver-public
STORAGE_REGION=us-east-1
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=10485760

# ── Map provider (RokTenh, openrouteservice-backed) ───────────────────────
MAP_BASE_URL=https://dev-map-api.roktenh.com
MAP_API_KEY=
MAP_TIMEOUT_MS=8000
# Place cache lifetime and the outage fallback are operator settings — see
# "Runtime settings" at the foot of this file.

# ── OTP ───────────────────────────────────────────────────────────────────
# The code's length is fixed here because the apps and the SMS template are
# written against it; the limits around it (lifetime, attempts, resend
# cooldown, hourly budget) are operator settings.
OTP_LENGTH=6
# Returns the code in the API response. NEVER enable outside local development.
# Deliberately not an operator setting: switching it on from the back office
# would hand anyone a working sign-in for any phone number.
OTP_EXPOSE_IN_RESPONSE=false

# Business-day boundary for back-office reporting. Storage stays UTC.
APP_TIMEZONE=Asia/Phnom_Penh

# ── Sign-in protection ────────────────────────────────────────────────────
# Failures are counted per account — a phone's mobile account and its
# back-office account lock independently.
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
# A refresh from a different device is always refused. Set this to true to
# also refuse one that names no device — once every app build sends it.
AUTH_REFRESH_REQUIRE_DEVICE=false
# Changing bank details and requesting a payout ask for the password again
# (POST /auth/step-up). A wrong or expired confirmation is always refused. Set
# this to true to also refuse a request carrying none — once the driver app
# in the field asks for the password first.
AUTH_STEP_UP_REQUIRED=false

# ── SMS gateway (PlasGate) ────────────────────────────────────────────────
# Carries OTP codes. Leave blank to write codes to the log instead, which is
# how local development works.
PLASGATE_BASE_URL=https://cloudapi.plasgate.com/rest/send
PLASGATE_PRIVATE_KEY=
# Escape every $ as \$ — values here go through variable expansion, and a
# key like $5$rounds=... is otherwise silently eaten down to $5=...
PLASGATE_SECRET_KEY=
PLASGATE_SENDER=

# ── Delivery & matching ───────────────────────────────────────────────────
BOOKING_CODE_PREFIX=ORD
DELIVERY_ARRIVAL_RADIUS_METERS=300
DELIVERY_STALLED_AFTER_MINUTES=10
MATCHING_RADIUS_METERS=5000
MATCHING_MAX_RADIUS_METERS=15000
MATCHING_BATCH_SIZE=5
MATCHING_OFFER_TTL_SECONDS=30
MATCHING_MAX_ROUNDS=4
MATCHING_ENABLED=true

# ── Payouts ───────────────────────────────────────────────────────────────
WITHDRAWAL_MIN_AMOUNT_KHR=20000
WITHDRAWAL_MAX_AMOUNT_KHR=4000000
WITHDRAWAL_FEE_KHR=0

# ── Payments (ABA PayWay) ─────────────────────────────────────────────────
# KHQR is issued through the merchant's ABA PayWay account. Without a merchant
# id and key the method is reported unavailable rather than failing at checkout.
# Sandbox: https://checkout-sandbox.payway.com.kh
# Production: https://checkout.payway.com.kh  (needs production credentials)
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Currencies this merchant account is enabled for.
PAYWAY_CURRENCIES=USD
PAYWAY_RETURN_URL=

# ── Push notifications (Firebase service account) ─────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Back office bootstrap ─────────────────────────────────────────────────
# Creates a super admin on the first seed, and only when no back-office
# account exists yet. Leave blank in any environment where you do not want a
# known set of credentials.
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Runtime settings (not here) ───────────────────────────────────────────
# These are changed by an operator in the back office, under Settings, and
# take effect without a deploy:
#
#   Matching          search radius, drivers per round, offer timeout, rounds
#   Operations        arrival radius, stalled-after, driver presence TTL,
#                     track-point interval
#   Verification      OTP lifetime, attempts, resend cooldown, hourly budget,
#                     time to finish after verifying
#   Maps              place cache lifetime, estimate routes during an outage
#   Payments          PayWay checkout window
#   Payouts           smallest and largest withdrawal, withdrawal fee
#
# Each still falls back to its environment variable when nothing is stored, so
# a deployment can set one here to change its own starting point. The full list
# with current values is GET /admin/settings.

# ── Credentials (optionally not here either) ──────────────────────────────
# With SECRETS_MASTER_KEY set, these can be stored encrypted in the database
# and removed from this file:
#
#   JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, ENCRYPTION_KEY
#   STORAGE_* (endpoint, port, SSL, keys, buckets, region)
#   MAP_API_KEY, PAYWAY_API_KEY, FCM_*
#   PLASGATE_* , SWAGGER_PASSWORD, ADMIN_BOOTSTRAP_*
#
#   npm run db:secrets -- list             what is stored, masked
#   npm run db:secrets -- import           move everything from this file
#   npm run db:secrets -- set KEY "value"
#
# There is no HTTP endpoint for these, unlike runtime settings: they are read
# once at boot. A value stored here in the file always takes precedence, so
# removing the line is what switches a key over to the database.
