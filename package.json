{
  "name": "deliver-new",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "swagger:export": "npm run build && node dist/bootstrap/export-openapi.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "NODE_ENV=test vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "npm run build && node dist/database/seed.js",
    "db:studio": "prisma studio",
    "db:test:deploy": "NODE_ENV=test prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "postinstall": "prisma generate",
    "db:test:seed": "npm run build && NODE_ENV=test node dist/database/seed.js"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.0",
